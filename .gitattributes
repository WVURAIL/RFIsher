# Keep distributed scientific inputs byte-stable across operating systems.
*.py text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cff text eol=lf
requirements/*.txt text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
scripts/dissertation/data/*.csv text eol=lf
src/rfisher/data/*.csv text eol=lf
src/rfisher/data/*.json text eol=lf
src/rfisher/data/*.npz binary
src/rfisher/data/*.dat text eol=lf
src/rfisher/data/response_banks/*.npz binary
src/rfisher/data/tolerances/* text eol=lf
projects/**/*.yaml text eol=lf
tests/golden/*.json text eol=lf

# Release evidence hashes identify the checked-in bytes, independent of a
# contributor's core.autocrlf setting.
docs/*.schema.json text eol=lf
docs/releases/*.json text eol=lf

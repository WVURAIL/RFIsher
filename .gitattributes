# Keep the shipped scientific inputs byte-stable across operating systems.
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cff text eol=lf
*.svg text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
src/rfisher/data/*.csv text eol=lf
src/rfisher/data/*.json text eol=lf
src/rfisher/data/*.dat text eol=lf
*.png binary
